      "destination": "/cookie-policy/index.html"
    },
    {
      "source": "/services/gastrointestinal-specialist-consultation",
      "destination": "/services/gastrointestinal-specialist-consultation/index.html"
    },
    {
      "source": "/services/colonoscopy-lower-gi-endoscopy",
