{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "seo-build.ts",
    "src/data/seo.ts",
    "src/data/healthResources.ts",
    "src/data/services.ts",
    "src/data/assets.ts",
    "src/data/faqs.ts",
    "src/data/serviceDetails.ts",
    "src/data/links.ts",
    "src/lib/analytics.ts",
    "src/lib/consent.ts"
  ]
}
